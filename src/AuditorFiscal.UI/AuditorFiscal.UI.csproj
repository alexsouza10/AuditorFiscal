<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Gerenciador de AFT</AssemblyName>
    <RootNamespace>AuditorFiscal.UI</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Executável único (requisito do CLAUDE.md): self-contained precisa ser explícito a
    partir do SDK do .NET 8 — informar só o RuntimeIdentifier não basta e resultaria,
    silenciosamente, em um build dependente do runtime instalado na máquina do auditor.
    Sem trimming: Avalonia (XAML/reflection) e EF Core não são totalmente
    trim-safe: cortar assemblies arriscaria quebrar o app em produção.

    IncludeAllContentForSelfExtract fica de fora de propósito: com ele ligado, o .NET
    extrai o pacote inteiro (DLLs gerenciadas, recursos, ~300MB) para uma pasta temp no
    disco na primeira abertura de cada build — é isso que causava a demora e o pico de
    CPU/disco só na primeira vez que o app era aberto após publicar. Só as bibliotecas
    nativas (Skia, HarfBuzz, SQLite) PRECISAM ser extraídas para arquivo — o resto o
    runtime lê direto de dentro do executável, sem esse custo inicial.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuditorFiscal.Domain\AuditorFiscal.Domain.csproj" />
    <ProjectReference Include="..\AuditorFiscal.Application\AuditorFiscal.Application.csproj" />
    <ProjectReference Include="..\AuditorFiscal.Persistence\AuditorFiscal.Persistence.csproj" />
    <ProjectReference Include="..\AuditorFiscal.Infrastructure\AuditorFiscal.Infrastructure.csproj" />
    <ProjectReference Include="..\AuditorFiscal.Shared\AuditorFiscal.Shared.csproj" />
  </ItemGroup>
</Project>
