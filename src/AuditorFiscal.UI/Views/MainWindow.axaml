<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AuditorFiscal.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="740"
        x:Class="AuditorFiscal.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico"
        Title="APURA"
        Width="1200" Height="740"
        MinWidth="900" MinHeight="600">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NovaOrdemServicoCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding VisualizarCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding BancoDadosCommand}" />
        <KeyBinding Gesture="Ctrl+H" Command="{Binding InicioCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding AlternarTemaCommand}" />
        <KeyBinding Gesture="Ctrl+K" Command="{Binding DashboardCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding VoltarCommand}" />
    </Window.KeyBindings>

    <DockPanel Background="{DynamicResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top" Padding="14,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="🛡 APURA" FontWeight="SemiBold"
                           VerticalAlignment="Center" Opacity="0.85" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center">
                    <Button Content="🏠 Início" Classes="navBar" Command="{Binding InicioCommand}"
                            ToolTip.Tip="Início (Ctrl+H)" />
                    <Button Content="📋 Nova O.S." Classes="navBar" Command="{Binding NovaOrdemServicoCommand}"
                            ToolTip.Tip="Nova Ordem de Serviço (Ctrl+N)" />
                    <Button Content="📊 Cronograma" Classes="navBar" Command="{Binding VisualizarCommand}"
                            ToolTip.Tip="Cronograma GANTT (Ctrl+G)" />
                    <Button Content="🗄 Banco de Dados" Classes="navBar" Command="{Binding BancoDadosCommand}"
                            ToolTip.Tip="Banco de Dados (Ctrl+B)" />
                    <Button Content="📈 Dashboard" Classes="navBar" Command="{Binding DashboardCommand}"
                            ToolTip.Tip="Dashboard (Ctrl+K)" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="{Binding IconeTema}" Command="{Binding AlternarTemaCommand}"
                            ToolTip.Tip="Alternar tema claro/escuro (Ctrl+D)"
                            AutomationProperties.AutomationId="BtnTema" />
                    <Button Content="⚙" Command="{Binding ConfiguracoesCommand}"
                            ToolTip.Tip="Configurações"
                            AutomationProperties.AutomationId="BtnConfiguracoes" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

</Window>
