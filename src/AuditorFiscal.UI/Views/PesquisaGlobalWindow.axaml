<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AuditorFiscal.UI.ViewModels"
        xmlns:entities="using:AuditorFiscal.Domain.Entities"
        xmlns:local="using:AuditorFiscal.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
        x:Class="AuditorFiscal.UI.Views.PesquisaGlobalWindow"
        x:DataType="vm:PesquisaGlobalViewModel"
        Title="Pesquisa Global"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Resources>
        <local:SituacaoParaDescricaoConverter x:Key="SituacaoParaDescricao" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding AbrirSelecionadoCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding FecharCommand}" />
        <KeyBinding Gesture="Down" Command="{Binding MoverSelecaoCommand}" CommandParameter="baixo" />
        <KeyBinding Gesture="Up" Command="{Binding MoverSelecaoCommand}" CommandParameter="cima" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBox Grid.Row="0" x:Name="CaixaConsulta" Text="{Binding Consulta}"
                  PlaceholderText="Pesquisar O.S., empresa, cidade… (ex.: atrasadas, empresa:toyota, prazo&lt;5)"
                  AutomationProperties.AutomationId="TxtPesquisaGlobal" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Resultados}" SelectedItem="{Binding Selecionado}"
                     DoubleTapped="ListBox_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="entities:OrdemServico">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Empresa}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.6">
                                <TextBlock Text="{Binding Numero}" FontSize="11" />
                                <TextBlock Text="{Binding Cidade}" FontSize="11" />
                                <TextBlock Text="{Binding Converter={StaticResource SituacaoParaDescricao}}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding SemResultados}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="Nenhum resultado" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Opacity="0.5"
                    Text="↑ ↓ navegar · Enter abrir · Esc fechar" />
    </Grid>

</Window>
