<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:gantt="using:AuditorFiscal.UI.ViewModels.Gantt"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:AuditorFiscal.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="740"
             x:Class="AuditorFiscal.UI.Views.GanttView"
             x:DataType="vm:GanttViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:ProporcaoParaPixelsConverter x:Key="ProporcaoParaPixels" />
            <local:ProporcaoParaMargemConverter x:Key="ProporcaoParaMargem" />
            <local:BoolParaEspessuraConverter x:Key="BoolParaEspessura" />
            <local:SituacaoParaDescricaoConverter x:Key="SituacaoParaDescricao" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BordaBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#232326" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20">

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="←" Command="{Binding VoltarCommand}" ToolTip.Tip="Voltar ao início" />
                <StackPanel>
                    <TextBlock Text="Cronograma GANTT" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Clique numa barra para ver detalhes da O.S." FontSize="12" Opacity="0.6" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="‹" Command="{Binding PeriodoAnteriorCommand}" Width="36" />
                <TextBlock Text="{Binding TituloPeriodo}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" MinWidth="220" TextAlignment="Center" />
                <Button Content="›" Command="{Binding ProximoPeriodoCommand}" Width="36" />
                <Button Content="Hoje" Command="{Binding HojeCommand}" Margin="8,0,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Content="+ Nova OS" Classes="accent"
                    Command="{Binding NovaOrdemCommand}" VerticalAlignment="Center" />
        </Grid>

        <!-- Filtros: busca por OS/CNPJ/empresa, período rápido e intervalo personalizado -->
        <Border Grid.Row="1" Padding="12" CornerRadius="8" Margin="0,0,0,14"
                Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBox Text="{Binding FiltroTexto}" PlaceholderText="Buscar por O.S., CNPJ ou empresa…"
                         Width="260" Margin="0,0,16,0" AutomationProperties.AutomationId="TxtBuscaGantt" />

                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Período:" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="3 meses" Command="{Binding DefinirPeriodoCommand}" CommandParameter="3" />
                    <Button Content="6 meses" Command="{Binding DefinirPeriodoCommand}" CommandParameter="6" />
                    <Button Content="1 ano (padrão)" Command="{Binding DefinirPeriodoCommand}" CommandParameter="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Intervalo:" FontSize="12" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <CalendarDatePicker SelectedDate="{Binding FiltroInicio}" PlaceholderText="Início" Width="130" />
                    <TextBlock Text="—" VerticalAlignment="Center" Opacity="0.6" />
                    <CalendarDatePicker SelectedDate="{Binding FiltroFim}" PlaceholderText="Fim" Width="130" />
                    <Button Content="Aplicar" Command="{Binding AplicarPeriodoPersonalizadoCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Área principal: gráfico + painel de detalhes, ambos esticando com a janela -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

            <Border Grid.Column="0" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <DockPanel>

                    <!-- Régua de meses -->
                    <Grid DockPanel.Dock="Top" x:Name="AreaReguaMeses">
                        <ItemsControl ItemsSource="{Binding Meses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gantt:MesGanttViewModel">
                                    <Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,1,1" Padding="0,10">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProporcaoParaPixels}">
                                                <Binding Path="LarguraProporcional" />
                                                <Binding Path="#AreaReguaMeses.Bounds.Width" />
                                            </MultiBinding>
                                        </Border.Width>
                                        <StackPanel HorizontalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Rotulo}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Opacity="0.75" />
                                            <TextBlock Text="{Binding Ano}" FontSize="10" HorizontalAlignment="Center" Opacity="0.5" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Linhas do gráfico -->
                    <ScrollViewer>
                        <Grid x:Name="AreaTimeline">
                            <ItemsControl ItemsSource="{Binding Linhas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gantt:LinhaGanttViewModel">
                                        <Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,0,1" Height="76">
                                            <Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center">

                                                <Button Grid.Row="0" Classes="ganttBar" HorizontalAlignment="Left" Padding="0"
                                                        Command="{Binding $parent[UserControl].((vm:GanttViewModel)DataContext).SelecionarLinhaCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Margin>
                                                        <MultiBinding Converter="{StaticResource ProporcaoParaMargem}">
                                                            <Binding Path="MargemEsquerda" />
                                                            <Binding Path="#AreaTimeline.Bounds.Width" />
                                                        </MultiBinding>
                                                    </Button.Margin>
                                                    <Border CornerRadius="5" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource SystemAccentColor}"
                                                            BorderThickness="{Binding Selecionada, Converter={StaticResource BoolParaEspessura}}">
                                                        <Grid>
                                                            <ItemsControl ItemsSource="{Binding Segmentos}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="gantt:SegmentoGanttViewModel">
                                                                        <Rectangle Fill="{Binding Cor}" Height="40"
                                                                                   Stroke="{DynamicResource BordaBrush}" StrokeThickness="0.6"
                                                                                   ToolTip.Tip="{Binding Rotulo}">
                                                                            <Rectangle.Width>
                                                                                <MultiBinding Converter="{StaticResource ProporcaoParaPixels}">
                                                                                    <Binding Path="LarguraProporcional" />
                                                                                    <Binding Path="#AreaTimeline.Bounds.Width" />
                                                                                </MultiBinding>
                                                                            </Rectangle.Width>
                                                                        </Rectangle>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Rótulo sobreposto DENTRO da barra, não numa coluna fixa ao lado -->
                                                            <Border Background="#40000000" CornerRadius="3" Padding="6,2"
                                                                    Margin="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Empresa}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                                    <TextBlock Text="{Binding Numero}" FontSize="10" Foreground="White" Opacity="0.85" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Button>

                                                <!-- Barrinha azul: só simboliza que a O.S. tem NCRE cadastrado, na posição do prazo -->
                                                <Border Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                        IsVisible="{Binding TemNcre}">
                                                    <Rectangle Width="28" Height="6" RadiusX="3" RadiusY="3"
                                                               Fill="#3B82F6" HorizontalAlignment="Left"
                                                               ToolTip.Tip="{Binding NcreTexto}">
                                                        <Rectangle.Margin>
                                                            <MultiBinding Converter="{StaticResource ProporcaoParaMargem}">
                                                                <Binding Path="MargemNcre" />
                                                                <Binding Path="#AreaTimeline.Bounds.Width" />
                                                            </MultiBinding>
                                                        </Rectangle.Margin>
                                                    </Rectangle>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Linha vertical de HOJE -->
                            <Line StartPoint="0,0" EndPoint="0,2000" Stroke="#EF4444" StrokeThickness="1.5"
                                  StrokeDashArray="4,3" IsVisible="{Binding HojeVisivel}"
                                  HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Line.Margin>
                                    <MultiBinding Converter="{StaticResource ProporcaoParaMargem}">
                                        <Binding Path="PosicaoLinhaHoje" />
                                        <Binding Path="#AreaTimeline.Bounds.Width" />
                                    </MultiBinding>
                                </Line.Margin>
                            </Line>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Painel de detalhes -->
            <Border Grid.Column="1" Width="310" Margin="16,0,0,0" Padding="18" CornerRadius="8"
                    Background="{DynamicResource CartaoBrush}"
                    BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                    IsVisible="{Binding TemSelecao}">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="✕" HorizontalAlignment="Right" Padding="8,4"
                            Command="{Binding FecharDetalheCommand}" ToolTip.Tip="Fechar detalhes" />

                    <ScrollViewer>
                        <StackPanel Spacing="10" DataContext="{Binding Selecionada}"
                                    x:DataType="gantt:LinhaGanttViewModel">
                            <Border Background="{Binding CorSituacao}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SituacaoTexto}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Text="{Binding Empresa}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Numero}" Opacity="0.7" FontSize="12" />

                            <StackPanel Spacing="2">
                                <TextBlock Text="Fiscalização" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding FiscalizacaoTexto}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Recebimento SFIT" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding OrdemServico.RecebimentoSfit, StringFormat='{}{0:dd/MM/yyyy}'}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Data final" FontSize="11" Opacity="0.6" />
                                <TextBlock Text="{Binding OrdemServico.DataFinal, StringFormat='{}{0:dd/MM/yyyy}'}" />
                            </StackPanel>

                            <Separator Margin="0,6" />

                            <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].DataContext}"
                                        x:DataType="vm:GanttViewModel">
                                <TextBlock Text="Alterar situação" FontSize="11" Opacity="0.6" />
                                <ComboBox ItemsSource="{Binding SituacoesDisponiveis}" SelectedItem="{Binding SituacaoEdicao}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SituacaoParaDescricao}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Aplicar" Command="{Binding AplicarSituacaoCommand}" HorizontalAlignment="Stretch" />

                                <Separator Margin="0,6" />

                                <Button Content="Abrir / Editar" Classes="accent" HorizontalAlignment="Stretch"
                                        Command="{Binding AbrirDetalheCommand}" />
                                <Button Content="Histórico" HorizontalAlignment="Stretch" Command="{Binding AbrirHistoricoCommand}" />
                                <Button Content="Adiar 1 semana" HorizontalAlignment="Stretch" Command="{Binding AdiarUmaSemanaCommand}" />
                                <Button Content="Favoritar" HorizontalAlignment="Stretch" Command="{Binding AlternarFavoritoCommand}" />
                                <Button Content="Exportar PDF" HorizontalAlignment="Stretch" Command="{Binding ExportarPdfCommand}" />
                                <Button Content="Imprimir" HorizontalAlignment="Stretch" Command="{Binding ImprimirCommand}" />
                                <Button Content="Excluir" HorizontalAlignment="Stretch" Command="{Binding ExcluirCommand}"
                                        Foreground="#EF4444" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Legenda -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" CornerRadius="8"
                Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#D4D4D8"
                               Stroke="{DynamicResource BordaBrush}" StrokeThickness="1" />
                    <TextBlock Text="1. Recebimento SFIT" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#3B82F6" />
                    <TextBlock Text="2. Abertura SFIT" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#22C55E" />
                    <TextBlock Text="3. Fiscalização" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#EAB308" />
                    <TextBlock Text="4. Prazo NAD" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,0">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#F97316" />
                    <TextBlock Text="5. Prazo NCO" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#EF4444" />
                    <TextBlock Text="6. Autos / Final" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Notificações de NCRE -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12" CornerRadius="8"
                Background="#332F1300" BorderBrush="#EAB308" BorderThickness="1"
                IsVisible="{Binding TemNotificacoesNcre}">
            <StackPanel Spacing="6">
                <TextBlock Text="⚠ Notificações NCRE" FontWeight="SemiBold" FontSize="12" Foreground="#EAB308" />
                <ItemsControl ItemsSource="{Binding NotificacoesNcre}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gantt:NotificacaoNcreViewModel">
                            <Button Classes="linkNotificacao" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Command="{Binding $parent[UserControl].((vm:GanttViewModel)DataContext).AbrirNotificacaoNcreCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Texto}" FontSize="12" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding MensagemStatus}" Opacity="0.75" Margin="0,10,0,0"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   IsVisible="{Binding MensagemStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

    </Grid>

</UserControl>
