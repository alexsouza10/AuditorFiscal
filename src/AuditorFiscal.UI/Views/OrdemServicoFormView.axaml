<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:entities="using:AuditorFiscal.Domain.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:AuditorFiscal.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="AuditorFiscal.UI.Views.OrdemServicoFormView"
             x:DataType="vm:OrdemServicoFormViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:SituacaoParaDescricaoConverter x:Key="SituacaoParaDescricao" />
            <local:PapelAuditorParaDescricaoConverter x:Key="PapelAuditorParaDescricao" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BordaBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#232326" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="←" Command="{Binding VoltarCommand}" AutomationProperties.AutomationId="BtnVoltar" />
                <TextBlock Text="{Binding TituloPagina}" Classes="pageTitle" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="🔍−" Command="{Binding DiminuirZoomCommand}" ToolTip.Tip="Diminuir zoom"
                        MinWidth="34" AutomationProperties.AutomationId="BtnDiminuirZoom" />
                <TextBlock Text="{Binding ZoomTexto}" VerticalAlignment="Center" MinWidth="44"
                           TextAlignment="Center" FontSize="12" Opacity="0.65" />
                <Button Content="🔍+" Command="{Binding AumentarZoomCommand}" ToolTip.Tip="Aumentar zoom"
                        MinWidth="34" AutomationProperties.AutomationId="BtnAumentarZoom" Margin="0,0,8,0" />
                <Button Content="{Binding FavoritoTexto}" Command="{Binding AlternarFavoritoCommand}" />
                <Button Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" IsEnabled="{Binding PodeExportar}" />
                <Button Content="Excluir" Command="{Binding ExcluirCommand}" Foreground="#EF4444" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Padding="0,14,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Content="Salvar" Command="{Binding SalvarCommand}" Classes="accent" MinWidth="120"
                        AutomationProperties.AutomationId="BtnSalvar" />
                <Button Content="Salvar e Criar Nova OS" Command="{Binding SalvarECriarNovaCommand}" MinWidth="180"
                        ToolTip.Tip="Salva esta OS e limpa o formulário para cadastrar a próxima"
                        AutomationProperties.AutomationId="BtnSalvarECriarNova" />
                <TextBlock Text="{Binding MensagemStatus}" Foreground="#22C55E" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MensagemErro}" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl SelectedIndex="{Binding AbaSelecionada}">
        <TabItem Header="Dados">
        <!-- Viewbox escala todo o conteúdo (campos, fontes, espaçamentos) na mesma proporção para
             sempre caber na tela sem rolagem: encolhe quando a janela é pequena e cresce junto com
             ela, até o teto de MaxWidth/MaxHeight — mais confiável que recalcular larguras à mão,
             porque fonte e caixa nunca saem de proporção uma da outra. Os botões de zoom (lupa)
             movem esse teto para cima/baixo a partir da base de 1560x860 (= 100%); quando a janela
             é menor que o teto, o encolhimento automático continua valendo normalmente. -->
        <Viewbox Stretch="Uniform" StretchDirection="Both"
                 MaxWidth="{Binding ZoomViewboxLargura}" MaxHeight="{Binding ZoomViewboxAltura}"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto">

                <!-- Dados principais: grid de 3 colunas iguais que preenche 100% da largura em
                     toda linha (campos longos ocupam a linha inteira) — sem lacunas — enquanto o
                     Viewbox cuida da escala geral conforme a janela aumenta ou diminui. -->
                <StackPanel Grid.Column="0" Width="800" Margin="0,0,24,0" Spacing="10">

                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="O.S. N°" Classes="fieldLabel" />
                            <TextBox Text="{Binding Numero}" PlaceholderText="{Binding NumeroPlaceholder}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Situação" Classes="fieldLabel" />
                            <ComboBox ItemsSource="{Binding SituacoesDisponiveis}"
                                      SelectedItem="{Binding SituacaoSelecionada}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SituacaoParaDescricao}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CNPJ" Classes="fieldLabel" />
                            <TextBox Text="{Binding Cnpj}" PlaceholderText="00.000.000/0000-00" />
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Descrição / Cliente" Classes="fieldLabel" />
                        <TextBox Text="{Binding Empresa}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="3. Fiscalização" Classes="fieldLabel" />
                            <ComboBox ItemsSource="{Binding TiposFiscalizacaoDisponiveis}"
                                      SelectedItem="{Binding FiscalizacaoSelecionada}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Responsável (opcional)" Classes="fieldLabel" />
                            <TextBox Text="{Binding Responsavel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Auditor (opcional)" Classes="fieldLabel" />
                            <ComboBox ItemsSource="{Binding PapeisAuditorDisponiveis}"
                                      SelectedItem="{Binding PapelAuditorSelecionado}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PapelAuditorParaDescricao}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,16,2*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CEP (opcional)" Classes="fieldLabel" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Cep}" PlaceholderText="00000-000" />
                                <Button Grid.Column="1" Content="Buscar endereço" Margin="8,0,0,0"
                                        Command="{Binding BuscarCepCommand}" AutomationProperties.AutomationId="BtnBuscarCep" />
                            </Grid>
                            <TextBlock Text="{Binding MensagemCep}" FontSize="11" Foreground="#EF4444"
                                       TextWrapping="Wrap" IsVisible="{Binding MensagemCep, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Endereço" Classes="fieldLabel" />
                            <TextBox Text="{Binding Endereco}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cidade" Classes="fieldLabel" />
                            <TextBox Text="{Binding Cidade}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Latitude (opcional)" Classes="fieldLabel" />
                            <TextBox Text="{Binding LatitudeTexto}" PlaceholderText="-23.550520" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Longitude (opcional)" Classes="fieldLabel" />
                            <TextBox Text="{Binding LongitudeTexto}" PlaceholderText="-46.633308" />
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Observações" Classes="fieldLabel" />
                        <TextBox Text="{Binding Observacoes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                    </StackPanel>

                </StackPanel>

                <!-- Etapas SFIT + Anexos -->
                <StackPanel Grid.Column="1" Spacing="12">

                    <Border Padding="12" CornerRadius="8" Background="{DynamicResource CartaoBrush}"
                            BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Etapas do fluxo SFIT" Classes="sectionTitle" Margin="0,0,0,2" />

                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0" MinWidth="120">
                                    <TextBlock Text="1. Recebimento SFIT" Classes="fieldLabel" ToolTip.Tip="Recebimento da OS no SFIT" />
                                    <CalendarDatePicker SelectedDate="{Binding RecebimentoSfit}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="120">
                                    <TextBlock Text="2. Abertura SFIT" Classes="fieldLabel" ToolTip.Tip="Abertura no SFIT" />
                                    <CalendarDatePicker SelectedDate="{Binding AberturaSfit}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,10,*" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" MinWidth="120">
                                    <TextBlock Text="3. Fiscalização" Classes="fieldLabel" ToolTip.Tip="Data da fiscalização" />
                                    <CalendarDatePicker SelectedDate="{Binding DataFiscalizacao}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="120">
                                    <TextBlock Text="4. Prazo NAD" Classes="fieldLabel" ToolTip.Tip="Prazo recebimento de documentos [NAD]" />
                                    <CalendarDatePicker SelectedDate="{Binding PrazoNad}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,10,*" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" MinWidth="120">
                                    <TextBlock Text="5. Prazo NCO" Classes="fieldLabel" ToolTip.Tip="Prazo cumprimento de obrigações [NCO]" />
                                    <CalendarDatePicker SelectedDate="{Binding PrazoNco}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="120">
                                    <TextBlock Text="6. Elaboração dos autos" Classes="fieldLabel" />
                                    <CalendarDatePicker SelectedDate="{Binding ElaboracaoAutos}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,10,*" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" MinWidth="120">
                                    <TextBlock Text="7. Data final" Classes="fieldLabel" />
                                    <CalendarDatePicker SelectedDate="{Binding DataFinal}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="120">
                                    <TextBlock Text=" " Classes="fieldLabel" />
                                    <CheckBox Content="Tem NCRE?" IsChecked="{Binding TemNcre}" MinHeight="34" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="ChkTemNcre" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding TemNcre}" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" MinWidth="120">
                                    <TextBlock Text="Início do NCRE" Classes="fieldLabel" />
                                    <CalendarDatePicker SelectedDate="{Binding NcreInicio}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="120">
                                    <TextBlock Text="Fim do NCRE" Classes="fieldLabel" />
                                    <CalendarDatePicker SelectedDate="{Binding NcreFim}" HorizontalAlignment="Stretch" PlaceholderText="dd/mm/aaaa" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Mostrar fotos e anexos" IsChecked="{Binding MostrarArquivos}"
                              AutomationProperties.AutomationId="ChkMostrarArquivos" />

                    <StackPanel Spacing="14" IsVisible="{Binding MostrarArquivos}">

                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource CartaoBrush}"
                            BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Fotos" Classes="sectionTitle" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ Adicionar" Command="{Binding AdicionarFotosCommand}"
                                        AutomationProperties.AutomationId="BtnAdicionarFotos" />
                            </Grid>
                            <TextBlock Text="Podem ser anexadas antes de salvar — o conteúdo é criptografado ao salvar."
                                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Fotos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArquivoItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding NomeArquivo}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Opacity="0.55">
                                                    <Run Text="{Binding DescricaoTamanho}" />
                                                    <Run Text="•" />
                                                    <Run Text="{Binding Situacao}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" FontSize="10" Padding="6,2"
                                                    Command="{Binding $parent[UserControl].((vm:OrdemServicoFormViewModel)DataContext).RemoverArquivoCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="14" CornerRadius="8" Background="{DynamicResource CartaoBrush}"
                            BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Anexos" Classes="sectionTitle" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ Adicionar" Command="{Binding AdicionarAnexosCommand}"
                                        AutomationProperties.AutomationId="BtnAdicionarAnexos" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Anexos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArquivoItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding NomeArquivo}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Opacity="0.55">
                                                    <Run Text="{Binding DescricaoTamanho}" />
                                                    <Run Text="•" />
                                                    <Run Text="{Binding Situacao}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" FontSize="10" Padding="6,2"
                                                    Command="{Binding $parent[UserControl].((vm:OrdemServicoFormViewModel)DataContext).RemoverArquivoCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </StackPanel>

                </StackPanel>

            </Grid>
        </Viewbox>
        </TabItem>

        <TabItem Header="Histórico" IsEnabled="{Binding PodeExportar}">
            <ScrollViewer>
                <StackPanel Margin="24" MaxWidth="700" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="Histórico de alterações" Classes="pageTitle" />
                    <TextBlock Text="Todas as alterações registradas nesta O.S., da mais recente para a mais antiga."
                               Opacity="0.6" FontSize="12" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="entities:TimelineEvento">
                                <Border Padding="12" CornerRadius="8" Margin="0,0,0,8"
                                        Background="{DynamicResource CartaoBrush}"
                                        BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding OcorridoEm.LocalDateTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="11" Opacity="0.55" />
                                        <TextBlock Text="{Binding Descricao}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

    </DockPanel>

</UserControl>
