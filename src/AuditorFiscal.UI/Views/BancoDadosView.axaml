<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:entities="using:AuditorFiscal.Domain.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:AuditorFiscal.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="AuditorFiscal.UI.Views.BancoDadosView"
             x:DataType="vm:BancoDadosViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:SituacaoParaDescricaoConverter x:Key="SituacaoParaDescricao" />
            <local:FiscalizacaoParaDescricaoConverter x:Key="FiscalizacaoParaDescricao" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CartaoBrush" Color="#232326" />
                    <SolidColorBrush x:Key="BordaBrush" Color="#3F3F46" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="CalendarDatePicker">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="←" Command="{Binding VoltarCommand}" ToolTip.Tip="Voltar ao início" />
                <TextBlock Text="Banco de Dados" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                <Button Content="Exportar Excel" Command="{Binding ExportarExcelCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MensagemStatus}" Opacity="0.7" Margin="0,10,0,0" />

        <Grid ColumnDefinitions="260,*">

            <!-- Filtros + dashboard -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pesquisa rápida" FontSize="11" Opacity="0.6" />
                        <TextBox Text="{Binding TermoBusca}" PlaceholderText="Número, empresa, cidade…"
                                 AutomationProperties.AutomationId="TxtBusca"
                                 ToolTip.Tip="Aceita filtros: status:andamento empresa:x cidade:x responsavel:x tag:x prazo&lt;10 atrasadas favoritas hoje semana sem-movimentacao" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Situação" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding SituacoesFiltro}" SelectedItem="{Binding SituacaoFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SituacaoParaDescricao}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Empresa" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding Empresas}" SelectedItem="{Binding EmpresaFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Cidade" FontSize="11" Opacity="0.6" />
                        <TextBox Text="{Binding CidadeFiltro}" PlaceholderText="Todas" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Responsável" FontSize="11" Opacity="0.6" />
                        <TextBox Text="{Binding ResponsavelFiltro}" PlaceholderText="Todos" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Fiscalização" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding FiscalizacoesFiltro}" SelectedItem="{Binding FiscalizacaoFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource FiscalizacaoParaDescricao}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Período (data final)" FontSize="11" Opacity="0.6" />
                        <CalendarDatePicker SelectedDate="{Binding DataInicioFiltro}" PlaceholderText="De" HorizontalAlignment="Stretch" />
                        <CalendarDatePicker SelectedDate="{Binding DataFimFiltro}" PlaceholderText="Até" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    </StackPanel>

                    <CheckBox Content="Somente favoritos" IsChecked="{Binding SomenteFavoritos}" />
                    <CheckBox Content="Somente atrasadas" IsChecked="{Binding SomenteAtrasadas}" />
                    <Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>

            <!-- Resultados + detalhe. O painel de detalhe flutua sobre a grade em vez de
                 ocupar uma coluna própria, para que a lista nunca fique espremida em
                 janelas estreitas e o painel sempre caiba na largura disponível. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <!-- Seleção para exportação + paginação -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox Content="Selecionar todos" IsChecked="{Binding SelecionarTodos}"
                                  ToolTip.Tip="Marca/desmarca todas as O.S. do filtro atual (todas as páginas) para exportação" />
                        <TextBlock Text="{Binding TotalSelecionados, StringFormat='{}{0} selecionada(s)'}"
                                   Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Itens por página" Opacity="0.6" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding TamanhosPagina}" SelectedItem="{Binding TamanhoPagina}" Width="80" />
                        <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Padding="8,4" ToolTip.Tip="Página anterior" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Página " /><Run Text="{Binding PaginaAtual}" /><Run Text=" de " /><Run Text="{Binding TotalPaginas}" />
                        </TextBlock>
                        <Button Content="▶" Command="{Binding ProximaPaginaCommand}" Padding="8,4" ToolTip.Tip="Próxima página" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                <Border BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="8">
                    <DataGrid ItemsSource="{Binding Resultados}" SelectedItem="{Binding LinhaSelecionada}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              AutomationProperties.AutomationId="GridResultados">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selecionada}" HorizontalAlignment="Center"
                                                  ToolTip.Tip="Selecionar para exportação" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120" />
                            <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="*" />
                            <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="130" />
                            <DataGridTextColumn Header="Recebimento SFIT" Binding="{Binding RecebimentoSfit, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130" />
                            <DataGridTextColumn Header="Data Final" Binding="{Binding DataFinal, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding Situacao, Converter={StaticResource SituacaoParaDescricao}}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Detalhe -->
                <Border Width="300" MaxWidth="320" Margin="16" Padding="16" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="{DynamicResource CartaoBrush}"
                        BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                        BoxShadow="0 4 16 0 #40000000"
                        IsVisible="{Binding TemSelecao}">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="✕" HorizontalAlignment="Right" Padding="8,4"
                                Command="{Binding FecharDetalheCommand}" ToolTip.Tip="Fechar detalhes" />

                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Selecionada.Empresa}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Selecionada.Numero}" Opacity="0.7" FontSize="12" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="CNPJ" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding Selecionada.Cnpj}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Endereço" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding Selecionada.Endereco}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Responsável" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding Selecionada.Responsavel}" />
                                </StackPanel>

                                <Separator Margin="0,4" />

                                <Button Content="Abrir / Editar" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding AbrirCommand}" />
                                <Button Content="Histórico desta O.S." HorizontalAlignment="Stretch" Command="{Binding AbrirHistoricoCommand}" />
                                <Button Content="Histórico da empresa" HorizontalAlignment="Stretch" Command="{Binding HistoricoDaEmpresaCommand}" />
                                <Button Content="Favoritar" HorizontalAlignment="Stretch" Command="{Binding AlternarFavoritoCommand}" />
                                <Button Content="Excluir" HorizontalAlignment="Stretch" Command="{Binding ExcluirCommand}" Foreground="#EF4444" />

                                <Separator Margin="0,4" />

                                <TextBlock Text="Timeline da auditoria" FontWeight="SemiBold" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding TimelineSelecionada}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:TimelineEvento">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding OcorridoEm.LocalDateTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                           FontSize="10" Opacity="0.6" />
                                                <TextBlock Text="{Binding Descricao}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
            </Grid>

        </Grid>

    </DockPanel>

</UserControl>
