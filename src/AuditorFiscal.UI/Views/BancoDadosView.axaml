<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:entities="using:AuditorFiscal.Domain.Entities"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="AuditorFiscal.UI.Views.BancoDadosView"
             x:DataType="vm:BancoDadosViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CartaoBrush" Color="#131316" />
                    <SolidColorBrush x:Key="BordaBrush" Color="#27272A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="20">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="←" Command="{Binding VoltarCommand}" ToolTip.Tip="Voltar ao início" />
                <TextBlock Text="Banco de Dados" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Exportar PDF" Command="{Binding ExportarPdfCommand}" />
                <Button Content="Exportar Excel" Command="{Binding ExportarExcelCommand}" />
                <Button Content="Imprimir" Command="{Binding ImprimirRelatorioCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MensagemStatus}" Opacity="0.7" Margin="0,10,0,0" />

        <Grid ColumnDefinitions="260,*,Auto">

            <!-- Filtros + dashboard -->
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pesquisa rápida" FontSize="11" Opacity="0.6" />
                        <TextBox Text="{Binding TermoBusca}" PlaceholderText="Número, empresa, cidade…"
                                 AutomationProperties.AutomationId="TxtBusca" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Situação" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding SituacoesFiltro}" SelectedItem="{Binding SituacaoFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Empresa" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding Empresas}" SelectedItem="{Binding EmpresaFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Tag" FontSize="11" Opacity="0.6" />
                        <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding TagFiltro}"
                                  HorizontalAlignment="Stretch" PlaceholderText="Todas">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TagSelecionavelViewModel">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="Somente favoritos" IsChecked="{Binding SomenteFavoritos}" />
                    <Button Content="Limpar filtros" Command="{Binding LimparFiltrosCommand}" HorizontalAlignment="Stretch" />

                    <Separator />

                    <TextBlock Text="Dashboard" FontWeight="SemiBold" />
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,6,6">
                            <TextBlock Text="{Binding Total}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Total" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding TotalAgendadas}" FontSize="20" FontWeight="Bold" Foreground="#3B82F6" />
                            <TextBlock Text="Agendadas" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding TotalConcluidas}" FontSize="20" FontWeight="Bold" Foreground="#22C55E" />
                            <TextBlock Text="Concluídas" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalFavoritas}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" />
                            <TextBlock Text="Favoritas" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Por situação" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding DistribuicaoSituacao}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarraDashboardViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Rotulo}" FontSize="11" />
                                        <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                   Width="{Binding Largura}" Fill="{Binding Cor}"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Por tipo de auditoria" FontSize="11" Opacity="0.6" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding DistribuicaoTipo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarraDashboardViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Rotulo}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                   Width="{Binding Largura}" Fill="{Binding Cor}"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Resultados -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Resultados}" SelectedItem="{Binding Selecionada}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          AutomationProperties.AutomationId="GridResultados">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="120" />
                        <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="*" />
                        <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="130" />
                        <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100" />
                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat='{}{0:HH\\:mm}'}" Width="70" />
                        <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detalhe -->
            <Border Grid.Column="2" Width="300" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CartaoBrush}"
                    BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1"
                    IsVisible="{Binding TemSelecao}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Selecionada.Empresa}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selecionada.Numero}" Opacity="0.7" FontSize="12" />

                        <StackPanel Spacing="2">
                            <TextBlock Text="CNPJ" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{Binding Selecionada.Cnpj}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Endereço" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{Binding Selecionada.Endereco}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Responsável" FontSize="11" Opacity="0.6" />
                            <TextBlock Text="{Binding Selecionada.Responsavel}" />
                        </StackPanel>

                        <Separator Margin="0,4" />

                        <Button Content="Abrir / Editar" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding AbrirCommand}" />
                        <Button Content="Histórico da empresa" HorizontalAlignment="Stretch" Command="{Binding HistoricoDaEmpresaCommand}" />
                        <Button Content="Favoritar" HorizontalAlignment="Stretch" Command="{Binding AlternarFavoritoCommand}" />
                        <Button Content="Excluir" HorizontalAlignment="Stretch" Command="{Binding ExcluirCommand}" Foreground="#EF4444" />

                        <Separator Margin="0,4" />

                        <TextBlock Text="Timeline da auditoria" FontWeight="SemiBold" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding TimelineSelecionada}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:TimelineEvento">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding OcorridoEm, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="10" Opacity="0.6" />
                                        <TextBlock Text="{Binding Descricao}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
