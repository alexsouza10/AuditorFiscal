<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:dtos="using:AuditorFiscal.Application.OrdensServico.Dtos"
             xmlns:local="using:AuditorFiscal.UI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="740"
             x:Class="AuditorFiscal.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <local:ProporcaoParaPixelsConverter x:Key="ProporcaoParaPixels" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BordaBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#232326" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.cartaoDash">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CartaoBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.chipIcone">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Layout responsivo: WrapPanel coloca os dois cartões lado a lado quando cabem
             (telas maiores) e empilha automaticamente quando a janela fica mais estreita
             (ex.: notebook) — sem depender de bindings de largura, que numa medição própria
             do contêiner (Bounds do próprio Grid pai) geram um ciclo de remedição instável. -->
        <Style Selector="Border.metadeCartao">
            <Setter Property="Width" Value="555" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>

        <!-- Cartão de alerta clicável: mesma aparência de Border.cartaoDash, mas como Button
             para levar direto à lista filtrada correspondente no Banco de Dados. -->
        <Style Selector="Button.cartaoAlerta">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CartaoBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BordaBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.cartaoAlerta:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="Button.linhaAlerta">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.linhaAlerta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Margin="24">
    <Border MaxWidth="1180" HorizontalAlignment="Center">
        <StackPanel Spacing="22" HorizontalAlignment="Stretch">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="←" Command="{Binding VoltarCommand}" ToolTip.Tip="Voltar ao início" />
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="Eficiência e panorama geral das ordens de serviço" FontSize="13" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Estado vazio: primeira execução, sem nenhuma O.S. cadastrada ainda -->
            <Border Classes="cartaoDash" Padding="48" IsVisible="{Binding SemDados}">
                <StackPanel HorizontalAlignment="Center" Spacing="10" MaxWidth="360">
                    <TextBlock Text="📈" FontSize="40" HorizontalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="Nenhuma ordem de serviço ainda" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="Assim que você cadastrar a primeira O.S., os indicadores e gráficos aparecem aqui."
                               FontSize="12" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="+ Nova Ordem de Serviço" Classes="accent" Margin="0,8,0,0"
                            HorizontalAlignment="Center" Command="{Binding NovaOrdemServicoCommand}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="22" IsVisible="{Binding !SemDados}">

            <!-- Painel de Controle Operacional: o que precisa de atenção imediata, sempre no
                 topo do Dashboard — é a primeira coisa que o auditor deve ver ao abrir o app. -->
            <Border Classes="cartaoDash">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠" FontSize="16" IsVisible="{Binding TemAlertas}" />
                        <TextBlock Text="✓" FontSize="16" IsVisible="{Binding !TemAlertas}" />
                        <TextBlock Text="Painel de Controle Operacional" Classes="sectionTitle" Margin="0" />
                    </StackPanel>

                    <UniformGrid Columns="4" Rows="1">
                        <Button Classes="cartaoAlerta" Margin="0,0,10,0" Command="{Binding AbrirAtrasadasCommand}"
                                ToolTip.Tip="Ver ordens de serviço atrasadas">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Atrasadas.Count}" FontSize="24" FontWeight="Bold" Foreground="#EF4444" />
                                <TextBlock Text="Atrasadas" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Classes="cartaoAlerta" Margin="0,0,10,0" Command="{Binding AbrirVencemHojeCommand}"
                                ToolTip.Tip="Ver prazos que vencem hoje">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding VencemHoje.Count}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B" />
                                <TextBlock Text="Vencem hoje" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Classes="cartaoAlerta" Margin="0,0,10,0" Command="{Binding AbrirVencemEmBreveCommand}"
                                ToolTip.Tip="Ver prazos dos próximos 7 dias">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding VencemEmBreve.Count}" FontSize="24" FontWeight="Bold" Foreground="#3B82F6" />
                                <TextBlock Text="Vencem em 7 dias" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button Classes="cartaoAlerta" Command="{Binding AbrirSemMovimentacaoCommand}"
                                ToolTip.Tip="Ver O.S. sem movimentação recente">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SemMovimentacao.Count}" FontSize="24" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock Text="Sem movimentação" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Estado tranquilo: nada pedindo atenção agora -->
                    <TextBlock Text="Nenhuma O.S. atrasada, com prazo vencendo ou parada. Tudo em dia."
                               FontSize="12" Opacity="0.6" IsVisible="{Binding !TemAlertas}" Margin="0,4,0,0" />

                    <!-- Acesso rápido às O.S. mais urgentes, sem precisar passar pelo Banco de Dados -->
                    <WrapPanel IsVisible="{Binding TemAlertas}">
                        <StackPanel Width="360" Margin="0,0,16,0" Spacing="4" IsVisible="{Binding TemAtrasadas}">
                            <TextBlock Text="Mais urgentes" FontSize="11" Opacity="0.6" Margin="8,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Atrasadas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:AlertaOrdemServicoDto">
                                        <Button Classes="linhaAlerta" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).AbrirOrdemServicoCommand}"
                                                CommandParameter="{Binding Id}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Empresa}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Numero}" FontSize="11" Opacity="0.6" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Dias, StringFormat='{}{0}d atraso'}"
                                                           FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Width="360" Spacing="4" IsVisible="{Binding TemVencemHoje}">
                            <TextBlock Text="Prazos de hoje" FontSize="11" Opacity="0.6" Margin="8,0,0,4" />
                            <ItemsControl ItemsSource="{Binding VencemHoje}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dtos:AlertaOrdemServicoDto">
                                        <Button Classes="linhaAlerta" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).AbrirOrdemServicoCommand}"
                                                CommandParameter="{Binding Id}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Empresa}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Numero}" FontSize="11" Opacity="0.6" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Descricao}"
                                                           FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Indicadores principais -->
            <UniformGrid Columns="5" Rows="1">
                <Border Classes="cartaoDash" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Classes="chipIcone" Background="#2294A3B8">
                            <TextBlock Text="🗂" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Total}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Total" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="cartaoDash" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Classes="chipIcone" Background="#223B82F6">
                            <TextBlock Text="📅" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TotalAgendadas}" FontSize="26" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" />
                        <TextBlock Text="Agendadas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="cartaoDash" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Classes="chipIcone" Background="#22F59E0B">
                            <TextBlock Text="⏳" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TotalEmAndamento}" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Text="Em andamento" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="cartaoDash" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Classes="chipIcone" Background="#2222C55E">
                            <TextBlock Text="✅" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TotalConcluidas}" FontSize="26" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center" />
                        <TextBlock Text="Concluídas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Classes="cartaoDash">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Classes="chipIcone" Background="#22EAB308">
                            <TextBlock Text="⭐" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding TotalFavoritas}" FontSize="26" FontWeight="Bold" Foreground="#EAB308" HorizontalAlignment="Center" />
                        <TextBlock Text="Favoritas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Eficiência de conclusão + produção mensal: o WrapPanel os mantém lado a lado
                 enquanto couberem juntos e empilha automaticamente quando a janela estreita -->
            <WrapPanel>

            <!-- Eficiência de conclusão -->
            <Border Classes="cartaoDash metadeCartao">
                <StackPanel Spacing="14">
                    <TextBlock Text="Eficiência de conclusão" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding TaxaConclusao, StringFormat='{}{0}%'}"
                                   FontSize="48" FontWeight="Bold" Foreground="#22C55E"
                                   VerticalAlignment="Center" Margin="0,0,24,0" />
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="das O.S. cadastradas já foram concluídas" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding TaxaConclusao}" Minimum="0" Maximum="100" Height="10" CornerRadius="5"
                                         Foreground="#22C55E" Background="#2222C55E" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasSemana}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Nesta semana" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasMes}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Neste mês" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasAno}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Neste ano" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Produção mensal: entradas (recebidas no SFIT) x saídas (concluídas) -->
            <Border Classes="cartaoDash metadeCartao">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Produção mensal" Classes="sectionTitle" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#3B82F6" />
                                <TextBlock Text="Recebidas" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#22C55E" />
                                <TextBlock Text="Concluídas" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- UniformGrid em vez de StackPanel de largura fixa: os 6 meses sempre dividem
                         igualmente a largura real do cartão, então o gráfico encolhe/cresce junto
                         com a janela em vez de vazar para fora quando o cartão fica mais estreito. -->
                    <ItemsControl ItemsSource="{Binding ProducaoMensal}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarraProducaoMensalViewModel">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <Border Height="120" MinWidth="54" VerticalAlignment="Bottom"
                                            BorderBrush="{DynamicResource BordaBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <Border Height="{Binding AlturaAbertasPixels}" Width="24" Background="#3B82F6"
                                                    CornerRadius="4,4,0,0" VerticalAlignment="Bottom"
                                                    ToolTip.Tip="{Binding Abertas, StringFormat='{}{0} recebida(s)'}" />
                                            <Border Height="{Binding AlturaConcluidasPixels}" Width="24" Background="#22C55E"
                                                    CornerRadius="4,4,0,0" VerticalAlignment="Bottom"
                                                    ToolTip.Tip="{Binding Concluidas, StringFormat='{}{0} concluída(s)'}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Rotulo}" FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            </WrapPanel>

            <!-- Rosca por situação + por tipo de fiscalização: mesmo WrapPanel responsivo -->
            <WrapPanel>

            <!-- Rosca por situação, com o total no miolo -->
            <Border Classes="cartaoDash metadeCartao">
                <StackPanel Spacing="10">
                    <TextBlock Text="Por situação" Classes="sectionTitle" />
                    <StackPanel Orientation="Horizontal" Spacing="44" HorizontalAlignment="Center" Margin="0,8">
                        <Grid Width="180" Height="180">
                            <ItemsControl ItemsSource="{Binding PizzaSituacao}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Panel Width="180" Height="180" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FatiaPizzaViewModel">
                                        <Path Data="{Binding Geometria}" Fill="{Binding Cor}"
                                              Stroke="{DynamicResource CartaoBrush}" StrokeThickness="2"
                                              ToolTip.Tip="{Binding Rotulo}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding Total}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="Total" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding PizzaSituacao}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FatiaPizzaViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding Cor}" />
                                        <TextBlock Text="{Binding Rotulo}" FontSize="13" />
                                        <TextBlock Text="{Binding Quantidade}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Percentual, StringFormat='({0}%)'}" FontSize="13" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Por tipo de fiscalização: a rosca ao lado já cobre a distribuição por situação
                 (com a mesma legenda), então esta seção evita repetir o mesmo recorte duas vezes -->
            <Border Classes="cartaoDash metadeCartao">
                <StackPanel Spacing="10">
                    <TextBlock Text="Por tipo de fiscalização" Classes="sectionTitle" />
                    <ItemsControl x:Name="AreaBarraTipo" ItemsSource="{Binding DistribuicaoTipo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarraDashboardViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Rotulo}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <Border Height="8" CornerRadius="0,4,4,0"
                                                Background="{Binding Cor}" HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProporcaoParaPixels}" ConverterParameter="52">
                                                    <Binding Path="Proporcao" />
                                                    <Binding Path="#AreaBarraTipo.Bounds.Width" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" Margin="8,0,0,0" MinWidth="20" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            </WrapPanel>

            </StackPanel>

        </StackPanel>
    </Border>
    </ScrollViewer>

</UserControl>
