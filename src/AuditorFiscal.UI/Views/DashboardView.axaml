<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AuditorFiscal.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="740"
             x:Class="AuditorFiscal.UI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BordaBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#F8FAFC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BordaBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="CartaoBrush" Color="#232326" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="24">
    <Border MaxWidth="1180" HorizontalAlignment="Center">
        <StackPanel Spacing="22" HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="←" Command="{Binding VoltarCommand}" ToolTip.Tip="Voltar ao início" />
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Eficiência e panorama geral das ordens de serviço" FontSize="13" Opacity="0.6" />
                </StackPanel>
            </StackPanel>

            <!-- Indicadores principais -->
            <UniformGrid Columns="5" Rows="1">
                <Border Margin="0,0,10,0" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Total}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Total" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding TotalAgendadas}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" />
                        <TextBlock Text="Agendadas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding TotalEmAndamento}" FontSize="28" FontWeight="Bold" Foreground="#EAB308" HorizontalAlignment="Center" />
                        <TextBlock Text="Em andamento" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,10,0" Padding="16" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding TotalConcluidas}" FontSize="28" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center" />
                        <TextBlock Text="Concluídas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding TotalFavoritas}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Text="Favoritas" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Eficiência de conclusão -->
            <Border Padding="18" CornerRadius="8"
                    Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Eficiência de conclusão" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding TaxaConclusao, StringFormat='{}{0}%'}"
                                   FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="das O.S. cadastradas já foram concluídas" FontSize="12" Opacity="0.7" />
                            <ProgressBar Value="{Binding TaxaConclusao}" Minimum="0" Maximum="100" Height="8" CornerRadius="4" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasSemana}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Concluídas nesta semana" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasMes}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Concluídas neste mês" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ConcluidasAno}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Concluídas neste ano" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Produção mensal: entradas (recebidas no SFIT) x saídas (concluídas) -->
            <Border Padding="18" CornerRadius="8"
                    Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Produção mensal — recebidas x concluídas" Classes="sectionTitle" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#3B82F6" />
                                <TextBlock Text="Recebidas" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="#22C55E" />
                                <TextBlock Text="Concluídas" FontSize="12" Opacity="0.75" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProducaoMensal}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="36" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarraProducaoMensalViewModel">
                                <StackPanel Width="72" Spacing="6">
                                    <Border Height="120" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <Rectangle Height="{Binding AlturaAbertasPixels}" Width="26" Fill="#3B82F6"
                                                       RadiusX="4" RadiusY="4" VerticalAlignment="Bottom"
                                                       ToolTip.Tip="{Binding Abertas, StringFormat='{}{0} recebida(s)'}" />
                                            <Rectangle Height="{Binding AlturaConcluidasPixels}" Width="26" Fill="#22C55E"
                                                       RadiusX="4" RadiusY="4" VerticalAlignment="Bottom"
                                                       ToolTip.Tip="{Binding Concluidas, StringFormat='{}{0} concluída(s)'}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Rotulo}" FontSize="12" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Pizza por situação -->
            <Border Padding="18" CornerRadius="8"
                    Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Por situação (pizza)" Classes="sectionTitle" />
                    <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" Margin="0,8">
                        <ItemsControl ItemsSource="{Binding PizzaSituacao}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Panel Width="180" Height="180" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FatiaPizzaViewModel">
                                    <Path Data="{Binding Geometria}" Fill="{Binding Cor}"
                                          Stroke="{DynamicResource CartaoBrush}" StrokeThickness="2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding PizzaSituacao}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FatiaPizzaViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6">
                                        <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding Cor}" />
                                        <TextBlock Text="{Binding Rotulo}" FontSize="13" />
                                        <TextBlock Text="{Binding Percentual, StringFormat='({0}%)'}" FontSize="13" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Distribuições -->
            <Grid ColumnDefinitions="*,16,*">
                <Border Grid.Column="0" Padding="18" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Por situação" Classes="sectionTitle" />
                        <ItemsControl ItemsSource="{Binding DistribuicaoSituacao}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarraDashboardViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Rotulo}" FontSize="12" />
                                            <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                       Width="{Binding Largura}" Fill="{Binding Cor}"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="12"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="18" CornerRadius="8"
                        Background="{DynamicResource CartaoBrush}" BorderBrush="{DynamicResource BordaBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Por tipo de fiscalização" Classes="sectionTitle" />
                        <ItemsControl ItemsSource="{Binding DistribuicaoTipo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarraDashboardViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Rotulo}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <Rectangle Height="8" RadiusX="4" RadiusY="4"
                                                       Width="{Binding Largura}" Fill="{Binding Cor}"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantidade}" FontSize="12"
                                                   VerticalAlignment="Bottom" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </Border>
    </ScrollViewer>

</UserControl>
