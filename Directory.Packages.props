<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI (Avalonia) -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Application -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />

    <!-- Persistence -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.29" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="8.0.29" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />

    <!-- Infrastructure -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <!-- Build GDI: resolve as fontes pelo Windows, evitando implementar um IFontResolver próprio. -->
    <PackageVersion Include="PDFsharp-gdi" Version="6.2.4" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Necessário para System.Drawing.Printing (impressão direta, sem arquivo temporário). -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.29" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="AwesomeAssertions" Version="9.1.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
